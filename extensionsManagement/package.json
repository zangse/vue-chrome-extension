{
  "name": "extensionsManagement",
  "description": "A Vue.js 3 project",
  "version": "1.0.0",
  "author": "zangse <zangse@live.com>",
  "private": true,
  "scripts": {
    "start": "webpack",
    "watch": "webpack --progress --watch",
    "build": "cross-env NODE_ENV=production webpack --progress",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "style:lint": "stylelint 'src/**/*.{css,scss,vue}'",
    "style:fix": "stylelint 'src/**/*.{css,scss,vue}' --fix",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "lint:all": "pnpm run lint && pnpm run style:lint",
    "fix:all": "pnpm run lint:fix && pnpm run style:fix"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-env": "^7.24.4",
    "@biomejs/biome": "2.1.2",
    "@vue/compiler-sfc": "^3.4.0",
    "babel-loader": "^9.1.3",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.3",
    "mini-css-extract-plugin": "^2.7.6",
    "sass": "^1.69.7",
    "sass-loader": "^13.3.2",
    "shelljs": "^0.8.5",
    "style-loader": "^3.3.4",
    "stylelint": "16.22.0",
    "stylelint-config-recommended-vue": "1.6.1",
    "stylelint-config-standard-scss": "15.0.1",
    "stylelint-scss": "6.12.1",
    "url-loader": "^4.1.1",
    "vue-loader": "^17.4.0",
    "vue-style-loader": "^4.1.3",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-hot-middleware": "^2.25.4",
    "webpack-merge": "^5.10.0",
    "@soda/friendly-errors-webpack-plugin": "^1.8.0"
  },
  "engines": {
    "node": ">= 14.0.0",
    "npm": ">= 6.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 11"
  ]
}
